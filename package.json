{
  "name": "@spinejit/pi-timeout-policy",
  "version": "0.4.0",
  "type": "module",
  "description": "One timeout policy for Pi's foreground tools: 60s when unset, 2h at most, and timeouts for grep and find too.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "timeout",
    "bash",
    "grep"
  ],
  "license": "Apache-2.0",
  "author": "GhabiX",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GhabiX/pi-timeout-policy.git"
  },
  "bugs": {
    "url": "https://github.com/GhabiX/pi-timeout-policy/issues"
  },
  "homepage": "https://github.com/GhabiX/pi-timeout-policy#readme",
  "pi": {
    "extensions": [
      "./extensions/tool-timeout.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/timeout-policy.test.mjs",
    "test:e2e": "node --experimental-strip-types --test test/e2e-runtime.test.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
